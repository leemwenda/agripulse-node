import { Router, Request, Response } from 'express';
import { z } from 'zod';
import prisma from '../lib/prisma';
import { requireAuth, getFarmId } from '../middleware/auth.middleware';

// ── MILK PRODUCTION ─────────────────────────────────────────
export const milkRouter = Router();
milkRouter.use(requireAuth);

const milkSchema = z.object({
  animalId: z.number().int().positive(),
  productionDate: z.string().min(1),
  quantityLiters: z.number().positive(),
  notes: z.string().optional(),
});

milkRouter.get('/', async (req: Request, res: Response) => {
   const farmId = getFarmId(req.user!);
   const query = req.query as Record<string, string | string[]>;
   const { animalId, from, to, page = '1', limit = '30' } = query;
   const where: Record<string, unknown> = { farmId };
   if (animalId) where.animalId = parseInt(Array.isArray(animalId) ? animalId[0] : animalId);
   if (from || to) {
     where.productionDate = {};
     if (from) (where.productionDate as Record<string, unknown>).gte = new Date(Array.isArray(from) ? from[0] : from);
     if (to) (where.productionDate as Record<string, unknown>).lte = new Date(Array.isArray(to) ? to[0] : to);
   }
   const skip = (parseInt(Array.isArray(page) ? page[0] : page) - 1) * parseInt(Array.isArray(limit) ? limit[0] : limit);
   const [total, records] = await Promise.all([
     prisma.milkProduction.count({ where }),
     prisma.milkProduction.findMany({
       where, skip, take: parseInt(Array.isArray(limit) ? limit[0] : limit),
       orderBy: { productionDate: 'desc' },
       include: { animal: { select: { name: true, tagNumber: true } } },
     }),
   ]);
   res.json({ records, total, page: parseInt(Array.isArray(page) ? page[0] : page) });
 });

milkRouter.post('/', async (req: Request, res: Response): Promise<void> => {
  const parsed = milkSchema.safeParse(req.body);
  if (!parsed.success) { res.status(400).json({ error: parsed.error.errors[0].message }); return; }
  const farmId = getFarmId(req.user!);
  try {
    const record = await prisma.milkProduction.create({
      data: {
        ...parsed.data,
        farmId,
        productionDate: new Date(parsed.data.productionDate),
        recordedBy: req.user!.id,
      },
    });
    res.status(201).json({ record });
  } catch (err: unknown) {
    const e = err as { code?: string };
    if (e.code === 'P2002') {
      res.status(409).json({ error: 'A record for this animal on that date already exists.' });
    } else { throw err; }
  }
});

milkRouter.put('/:id', async (req: Request, res: Response): Promise<void> => {
  const farmId = getFarmId(req.user!);
  const existing = await prisma.milkProduction.findFirst({ where: { id: parseInt(req.params.id), farmId } });
  if (!existing) { res.status(404).json({ error: 'Record not found' }); return; }
  const parsed = milkSchema.safeParse(req.body);
  if (!parsed.success) { res.status(400).json({ error: parsed.error.errors[0].message }); return; }
  const record = await prisma.milkProduction.update({
    where: { id: existing.id },
    data: { ...parsed.data, productionDate: new Date(parsed.data.productionDate) },
  });
  res.json({ record });
});

milkRouter.delete('/:id', async (req: Request, res: Response): Promise<void> => {
  const farmId = getFarmId(req.user!);
  const existing = await prisma.milkProduction.findFirst({ where: { id: parseInt(req.params.id), farmId } });
  if (!existing) { res.status(404).json({ error: 'Record not found' }); return; }
  await prisma.milkProduction.delete({ where: { id: existing.id } });
  res.json({ message: 'Record deleted.' });
});

// ── HEALTH RECORDS ───────────────────────────────────────────
export const healthRouter = Router();
healthRouter.use(requireAuth);

const healthSchema = z.object({
  animalId: z.number().int().positive(),
  recordDate: z.string().min(1),
  condition: z.string().min(1, 'Condition is required'),
  treatment: z.string().optional(),
  doctorName: z.string().optional(),
  vaccination: z.string().optional(),
  notes: z.string().optional(),
});

healthRouter.get('/', async (req: Request, res: Response) => {
   const farmId = getFarmId(req.user!);
   const query = req.query as Record<string, string | string[]>;
   const { animalId, page = '1', limit = '20' } = query;
   const where: Record<string, unknown> = { farmId };
   if (animalId) where.animalId = parseInt(Array.isArray(animalId) ? animalId[0] : animalId);
   const skip = (parseInt(Array.isArray(page) ? page[0] : page) - 1) * parseInt(Array.isArray(limit) ? limit[0] : limit);
   const [total, records] = await Promise.all([
     prisma.healthRecord.count({ where }),
     prisma.healthRecord.findMany({
       where, skip, take: parseInt(Array.isArray(limit) ? limit[0] : limit),
       orderBy: { recordDate: 'desc' },
       include: { animal: { select: { name: true, tagNumber: true } } },
     }),
   ]);
   res.json({ records, total });
 });

healthRouter.post('/', async (req: Request, res: Response): Promise<void> => {
  const parsed = healthSchema.safeParse(req.body);
  if (!parsed.success) { res.status(400).json({ error: parsed.error.errors[0].message }); return; }
  const farmId = getFarmId(req.user!);
  const record = await prisma.healthRecord.create({
    data: { ...parsed.data, farmId, recordDate: new Date(parsed.data.recordDate), recordedBy: req.user!.id },
  });
  res.status(201).json({ record });
});

healthRouter.put('/:id', async (req: Request, res: Response): Promise<void> => {
   const farmId = getFarmId(req.user!);
   const existing = await prisma.healthRecord.findFirst({ where: { id: parseInt(Array.isArray(req.params.id) ? req.params.id[0] : req.params.id), farmId } });
   if (!existing) { res.status(404).json({ error: 'Record not found' }); return; }
   const parsed = healthSchema.safeParse(req.body);
   if (!parsed.success) { res.status(400).json({ error: parsed.error.errors[0].message }); return; }
   const record = await prisma.healthRecord.update({
     where: { id: existing.id },
     data: { ...parsed.data, recordDate: new Date(parsed.data.recordDate) },
   });
   res.json({ record });
 });

healthRouter.delete('/:id', async (req: Request, res: Response): Promise<void> => {
  const farmId = getFarmId(req.user!);
  const existing = await prisma.healthRecord.findFirst({ where: { id: parseInt(req.params.id), farmId } });
  if (!existing) { res.status(404).json({ error: 'Record not found' }); return; }
  await prisma.healthRecord.delete({ where: { id: existing.id } });
  res.json({ message: 'Record deleted.' });
});

// ── BREEDING ─────────────────────────────────────────────────
export const breedingRouter = Router();
breedingRouter.use(requireAuth);

const breedingSchema = z.object({
  animalId: z.number().int().positive(),
  serviceDate: z.string().min(1),
  bullName: z.string().optional(),
  expectedBirthDate: z.string().optional(),
  actualBirthDate: z.string().optional(),
  pregnancyStatus: z.enum(['pending', 'pregnant', 'gave_birth', 'failed']).optional().default('pending'),
  notes: z.string().optional(),
});

breedingRouter.get('/', async (req: Request, res: Response) => {
   const farmId = getFarmId(req.user!);
   const query = req.query as Record<string, string | string[]>;
   const { status, page = '1', limit = '20' } = query;
   const where: Record<string, unknown> = { farmId };
   if (status) where.pregnancyStatus = Array.isArray(status) ? status[0] : status;
   const skip = (parseInt(Array.isArray(page) ? page[0] : page) - 1) * parseInt(Array.isArray(limit) ? limit[0] : limit);
   const [total, records] = await Promise.all([
     prisma.breeding.count({ where }),
     prisma.breeding.findMany({
       where, skip, take: parseInt(Array.isArray(limit) ? limit[0] : limit),
       orderBy: { serviceDate: 'desc' },
       include: { animal: { select: { name: true, tagNumber: true } } },
     }),
   ]);
   res.json({ records, total });
 });

breedingRouter.post('/', async (req: Request, res: Response): Promise<void> => {
  const parsed = breedingSchema.safeParse(req.body);
  if (!parsed.success) { res.status(400).json({ error: parsed.error.errors[0].message }); return; }
  const farmId = getFarmId(req.user!);
  const { serviceDate, expectedBirthDate, actualBirthDate, ...rest } = parsed.data;
  const record = await prisma.breeding.create({
    data: {
      ...rest,
      farmId,
      serviceDate: new Date(serviceDate),
      expectedBirthDate: expectedBirthDate ? new Date(expectedBirthDate) : null,
      actualBirthDate: actualBirthDate ? new Date(actualBirthDate) : null,
      recordedBy: req.user!.id,
    },
  });
  res.status(201).json({ record });
});

breedingRouter.put('/:id', async (req: Request, res: Response): Promise<void> => {
   const farmId = getFarmId(req.user!);
   const existing = await prisma.breeding.findFirst({ where: { id: parseInt(Array.isArray(req.params.id) ? req.params.id[0] : req.params.id), farmId } });
   if (!existing) { res.status(404).json({ error: 'Record not found' }); return; }
   const parsed = breedingSchema.safeParse(req.body);
   if (!parsed.success) { res.status(400).json({ error: parsed.error.errors[0].message }); return; }
   const { serviceDate, expectedBirthDate, actualBirthDate, ...rest } = parsed.data;
   const record = await prisma.breeding.update({
     where: { id: existing.id },
     data: {
       ...rest,
       serviceDate: new Date(serviceDate),
       expectedBirthDate: expectedBirthDate ? new Date(expectedBirthDate) : null,
       actualBirthDate: actualBirthDate ? new Date(actualBirthDate) : null,
     },
   });
   res.json({ record });
 });

breedingRouter.delete('/:id', async (req: Request, res: Response): Promise<void> => {
  const farmId = getFarmId(req.user!);
  const existing = await prisma.breeding.findFirst({ where: { id: parseInt(req.params.id), farmId } });
  if (!existing) { res.status(404).json({ error: 'Record not found' }); return; }
  await prisma.breeding.delete({ where: { id: existing.id } });
  res.json({ message: 'Record deleted.' });
});

// ── FINANCIAL TRANSACTIONS ───────────────────────────────────
export const financialRouter = Router();
financialRouter.use(requireAuth);

const txSchema = z.object({
  type: z.enum(['income', 'expense']),
  category: z.string().min(1, 'Category is required'),
  amount: z.number().positive('Amount must be positive'),
  description: z.string().optional(),
  transactionDate: z.string().min(1),
});

financialRouter.get('/', async (req: Request, res: Response) => {
   const farmId = getFarmId(req.user!);
   const query = req.query as Record<string, string | string[]>;
   const { type, from, to, page = '1', limit = '20' } = query;
   const where: Record<string, unknown> = { farmId };
   if (type) where.type = Array.isArray(type) ? type[0] : type;
   if (from || to) {
     where.transactionDate = {};
     if (from) (where.transactionDate as Record<string, unknown>).gte = new Date(Array.isArray(from) ? from[0] : from);
     if (to) (where.transactionDate as Record<string, unknown>).lte = new Date(Array.isArray(to) ? to[0] : to);
   }
   const skip = (parseInt(Array.isArray(page) ? page[0] : page) - 1) * parseInt(Array.isArray(limit) ? limit[0] : limit);
   const [total, transactions, summary] = await Promise.all([
     prisma.financialTransaction.count({ where }),
     prisma.financialTransaction.findMany({
       where, skip, take: parseInt(Array.isArray(limit) ? limit[0] : limit),
       orderBy: { transactionDate: 'desc' },
     }),
     prisma.financialTransaction.groupBy({
       by: ['type'],
       where: { farmId },
       _sum: { amount: true },
     }),
   ]);
   const income = summary.find(s => s.type === 'income')?._sum.amount || 0;
   const expense = summary.find(s => s.type === 'expense')?._sum.amount || 0;
   res.json({ transactions, total, summary: { income, expense, profit: Number(income) - Number(expense) } });
 });

financialRouter.post('/', async (req: Request, res: Response): Promise<void> => {
  const parsed = txSchema.safeParse(req.body);
  if (!parsed.success) { res.status(400).json({ error: parsed.error.errors[0].message }); return; }
  const farmId = getFarmId(req.user!);
  const transaction = await prisma.financialTransaction.create({
    data: { ...parsed.data, farmId, transactionDate: new Date(parsed.data.transactionDate), recordedBy: req.user!.id },
  });
  res.status(201).json({ transaction });
});

financialRouter.put('/:id', async (req: Request, res: Response): Promise<void> => {
  const farmId = getFarmId(req.user!);
  const existing = await prisma.financialTransaction.findFirst({ where: { id: parseInt(req.params.id), farmId } });
  if (!existing) { res.status(404).json({ error: 'Transaction not found' }); return; }
  const parsed = txSchema.safeParse(req.body);
  if (!parsed.success) { res.status(400).json({ error: parsed.error.errors[0].message }); return; }
  const transaction = await prisma.financialTransaction.update({
    where: { id: existing.id },
    data: { ...parsed.data, transactionDate: new Date(parsed.data.transactionDate) },
  });
  res.json({ transaction });
});

financialRouter.delete('/:id', async (req: Request, res: Response): Promise<void> => {
  const farmId = getFarmId(req.user!);
  const existing = await prisma.financialTransaction.findFirst({ where: { id: parseInt(req.params.id), farmId } });
  if (!existing) { res.status(404).json({ error: 'Transaction not found' }); return; }
  await prisma.financialTransaction.delete({ where: { id: existing.id } });
  res.json({ message: 'Transaction deleted.' });
});