import nodemailer from 'nodemailer';

function createTransport() {
  // Resend SMTP — works with any nodemailer-compatible provider
  return nodemailer.createTransport({
    host: 'smtp.resend.com',
    port: 465,
    secure: true,
    auth: {
      user: 'resend',
      pass: process.env.RESEND_API_KEY,
    },
  });
}

const FROM = process.env.MAIL_FROM || 'AgriPulse <noreply@agripulse.app>';
const SITE = process.env.SITE_NAME || 'AgriPulse';
const CLIENT_URL = process.env.CLIENT_URL || 'http://localhost:5173';

function baseTemplate(title: string, body: string): string {
  return `
<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <style>
    body { font-family: 'Inter', Arial, sans-serif; background: #f4f7f6; margin: 0; padding: 20px; }
    .card { max-width: 560px; margin: 0 auto; background: #fff; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 24px rgba(0,0,0,.06); }
    .header { background: linear-gradient(135deg, #1a6b3c, #155e75); padding: 32px 40px; text-align: center; }
    .header h1 { color: #fff; margin: 0; font-size: 24px; font-weight: 700; letter-spacing: -.3px; }
    .header p { color: rgba(255,255,255,.7); margin: 6px 0 0; font-size: 13px; }
    .body { padding: 36px 40px; color: #374151; line-height: 1.7; font-size: 15px; }
    .btn { display: inline-block; background: #1a6b3c; color: #fff; padding: 13px 28px; border-radius: 8px;
           text-decoration: none; font-weight: 600; font-size: 14px; margin: 20px 0; }
    .footer { background: #f9fafb; padding: 20px 40px; text-align: center; font-size: 12px; color: #9ca3af; border-top: 1px solid #f0f0f0; }
  </style>
</head>
<body>
  <div class="card">
    <div class="header">
      <h1>${SITE}</h1>
      <p>Smart Farm Management</p>
    </div>
    <div class="body">
      <h2 style="margin:0 0 16px;color:#111827;font-size:20px">${title}</h2>
      ${body}
    </div>
    <div class="footer">
      © ${new Date().getFullYear()} ${SITE}. All rights reserved.
    </div>
  </div>
</body>
</html>`;
}

export async function mailWelcome(email: string, name: string): Promise<void> {
  try {
    const transport = createTransport();
    await transport.sendMail({
      from: FROM,
      to: email,
      subject: `Welcome to ${SITE} 🌿`,
      html: baseTemplate('Welcome aboard!', `
        <p>Hi <strong>${name}</strong>,</p>
        <p>Your farm account has been created successfully. You can now log in and start managing your farm.</p>
        <a class="btn" href="${CLIENT_URL}/login">Sign in to ${SITE}</a>
        <p style="color:#6b7280;font-size:13px">If you didn't create this account, please ignore this email.</p>
      `),
    });
  } catch (err) {
    console.error('[Mail] Welcome failed:', err);
  }
}

export async function mailPendingApproval(email: string, name: string): Promise<void> {
  try {
    const transport = createTransport();
    await transport.sendMail({
      from: FROM,
      to: email,
      subject: `Account Under Review — ${SITE}`,
      html: baseTemplate('Account Under Review', `
        <p>Hi <strong>${name}</strong>,</p>
        <p>Thank you for registering! Your account is currently pending review by the platform administrator.</p>
        <p>You will receive another email once your account has been approved.</p>
        <p style="color:#6b7280;font-size:13px">This usually takes less than 24 hours.</p>
      `),
    });
  } catch (err) {
    console.error('[Mail] Pending approval failed:', err);
  }
}

export async function mailApproved(email: string, name: string): Promise<void> {
  try {
    const transport = createTransport();
    await transport.sendMail({
      from: FROM,
      to: email,
      subject: `Account Approved — ${SITE}`,
      html: baseTemplate('You\'re approved!', `
        <p>Hi <strong>${name}</strong>,</p>
        <p>Great news — your account has been approved. You can now sign in and start using ${SITE}.</p>
        <a class="btn" href="${CLIENT_URL}/login">Sign in now</a>
      `),
    });
  } catch (err) {
    console.error('[Mail] Approved failed:', err);
  }
}

export async function mailPasswordReset(email: string, name: string, token: string): Promise<void> {
  try {
    const transport = createTransport();
    const link = `${CLIENT_URL}/reset-password?token=${token}`;
    await transport.sendMail({
      from: FROM,
      to: email,
      subject: `Reset your password — ${SITE}`,
      html: baseTemplate('Reset Your Password', `
        <p>Hi <strong>${name}</strong>,</p>
        <p>We received a request to reset your password. Click the button below to set a new one.</p>
        <a class="btn" href="${link}">Reset Password</a>
        <p style="color:#6b7280;font-size:13px">This link expires in 1 hour. If you didn't request this, please ignore this email.</p>
      `),
    });
  } catch (err) {
    console.error('[Mail] Password reset failed:', err);
  }
}

export async function mailAdminNewRegistration(name: string, email: string, mode: string): Promise<void> {
  try {
    const adminEmail = process.env.ADMIN_EMAIL;
    if (!adminEmail) return;
    const transport = createTransport();
    await transport.sendMail({
      from: FROM,
      to: adminEmail,
      subject: `New Registration${mode === 'approval' ? ' (Needs Approval)' : ''} — ${SITE}`,
      html: baseTemplate('New User Registration', `
        <p>A new user has registered on ${SITE}.</p>
        <table style="width:100%;border-collapse:collapse;margin:16px 0">
          <tr><td style="padding:8px;color:#6b7280;width:100px">Name</td><td style="padding:8px;font-weight:600">${name}</td></tr>
          <tr><td style="padding:8px;color:#6b7280">Email</td><td style="padding:8px">${email}</td></tr>
          <tr><td style="padding:8px;color:#6b7280">Mode</td><td style="padding:8px">${mode === 'approval' ? '⏳ Requires approval' : '✅ Auto-approved'}</td></tr>
        </table>
        ${mode === 'approval' ? `<a class="btn" href="${CLIENT_URL}/admin/users">Review in Admin Panel</a>` : ''}
      `),
    });
  } catch (err) {
    console.error('[Mail] Admin notification failed:', err);
  }
}
