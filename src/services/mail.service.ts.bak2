import nodemailer from 'nodemailer';
import fs from 'fs';

// ─── Types ───────────────────────────────────────────────────────────────────
interface Provider {
  name: string;
  dailyLimit: number;
  send: (to: string, from: string, subject: string, html: string) => Promise<void>;
}
interface Tracker { date: string; counts: Record<string, number>; }

// ─── Usage Tracker ────────────────────────────────────────────────────────────
const TRACKER_FILE = '/home/mwenda/.agripulse_mail_tracker.json';
function today(): string { return new Date().toISOString().slice(0, 10); }
function loadTracker(): Tracker {
  try {
    if (fs.existsSync(TRACKER_FILE)) {
      const t = JSON.parse(fs.readFileSync(TRACKER_FILE, 'utf8')) as Tracker;
      if (t.date === today()) return t;
      console.log('[Mail] New day — resetting counters');
    }
  } catch {}
  return { date: today(), counts: {} };
}
function saveTracker(t: Tracker): void {
  try { fs.writeFileSync(TRACKER_FILE, JSON.stringify(t, null, 2)); } catch {}
}
function getCount(name: string): number { return loadTracker().counts[name] || 0; }
function increment(name: string): void {
  const t = loadTracker(); t.counts[name] = (t.counts[name] || 0) + 1; saveTracker(t);
}
function forceExhaust(name: string, limit: number): void {
  const t = loadTracker(); t.counts[name] = limit + 1; saveTracker(t);
}

// ─── Provider Pool ────────────────────────────────────────────────────────────
const PROVIDERS: Provider[] = [
  {
    name: 'postfix', dailyLimit: 1,  // disabled: DO blocks port 465
    send: async (to, from, subject, html) => {
      const t = nodemailer.createTransport({ host: '127.0.0.1', port: 25, secure: false, tls: { rejectUnauthorized: false } });
      await t.sendMail({ from, to, subject, html });
    },
  },
  {
    name: 'brevo', dailyLimit: 290,
    send: async (to, from, subject, html) => {
      const apiKey = process.env.BREVO_API_KEY;
      if (!apiKey) throw new Error('BREVO_API_KEY not set');
      const m = from.match(/^(.*?)\s*<(.+?)>$/);
      const res = await fetch('https://api.brevo.com/v3/smtp/email', {
        method: 'POST',
        headers: { 'api-key': apiKey, 'Content-Type': 'application/json' },
        body: JSON.stringify({ sender: { name: m ? m[1].trim() : 'AgriPulse', email: m ? m[2].trim() : from }, to: [{ email: to }], subject, htmlContent: html }),
      });
      if (!res.ok) throw new Error(`Brevo ${res.status}: ${await res.text()}`);
    },
  },
  {
    name: 'resend', dailyLimit: 95,
    send: async (to, from, subject, html) => {
      const apiKey = process.env.RESEND_API_KEY;
      if (!apiKey) throw new Error('RESEND_API_KEY not set');
      const res = await fetch('https://api.resend.com/emails', {
        method: 'POST',
        headers: { 'Authorization': `Bearer ${apiKey}`, 'Content-Type': 'application/json' },
        body: JSON.stringify({ from, to, subject, html }),
      });
      if (!res.ok) throw new Error(`Resend ${res.status}: ${await res.text()}`);
    },
  },
  {
    name: 'mailjet', dailyLimit: 190,
    send: async (to, from, subject, html) => {
      const apiKey = process.env.MAILJET_API_KEY;
      const secret = process.env.MAILJET_SECRET_KEY;
      if (!apiKey || !secret) throw new Error('MAILJET keys not set');
      const m = from.match(/^(.*?)\s*<(.+?)>$/);
      const creds = Buffer.from(`${apiKey}:${secret}`).toString('base64');
      const res = await fetch('https://api.mailjet.com/v3.1/send', {
        method: 'POST',
        headers: { 'Authorization': `Basic ${creds}`, 'Content-Type': 'application/json' },
        body: JSON.stringify({ Messages: [{ From: { Email: m ? m[2].trim() : from, Name: m ? m[1].trim() : 'AgriPulse' }, To: [{ Email: to }], Subject: subject, HTMLPart: html }] }),
      });
      if (!res.ok) throw new Error(`Mailjet ${res.status}: ${await res.text()}`);
    },
  },
];

// ─── Core Send ────────────────────────────────────────────────────────────────
const FROM  = process.env.MAIL_FROM   || 'AgriPulse <notifications@agripulse.me>';
const ADMIN = process.env.ADMIN_EMAIL || 'leemwenda8714@gmail.com';
const SITE  = process.env.SITE_NAME   || 'AgriPulse';
const URL   = process.env.CLIENT_URL  || 'https://agripulse.me';
const LOGO  = 'https://agripulse.me/agripulse-logo.png';

async function send(to: string, subject: string, html: string): Promise<void> {
  for (const provider of PROVIDERS) {
    if (provider.dailyLimit > 0 && getCount(provider.name) >= provider.dailyLimit) {
      console.log(`[Mail] "${provider.name}" at limit (${getCount(provider.name)}/${provider.dailyLimit}), trying next...`);
      continue;
    }
    try {
      await provider.send(to, FROM, subject, html);
      increment(provider.name);
      const count = getCount(provider.name);
      const limit = provider.dailyLimit > 0 ? `/${provider.dailyLimit}` : '/∞';
      console.log(`[Mail] ✓ "${provider.name}" (${count}${limit}): "${subject}" → ${to}`);
      return;
    } catch (err: unknown) {
      const msg = String(err).toLowerCase();
      const isQuota = ['quota', 'limit', 'exceeded', 'rate', 'too many', '452', '550', '421'].some(e => msg.includes(e));
      console.error(`[Mail] ✗ "${provider.name}" failed:`, err);
      if (isQuota && provider.dailyLimit > 0) {
        forceExhaust(provider.name, provider.dailyLimit);
        console.log(`[Mail] Quota hit on "${provider.name}", rotating...`);
      }
    }
  }
  console.error('[Mail] ✗ All providers failed:', subject, '→', to);
}

// ─── Pool Status ──────────────────────────────────────────────────────────────
export function getMailPoolStatus() {
  const t = loadTracker();
  return PROVIDERS.map(p => ({
    name: p.name,
    dailyLimit: p.dailyLimit === 0 ? 'unlimited' : p.dailyLimit,
    sentToday: t.counts[p.name] || 0,
    remaining: p.dailyLimit === 0 ? '∞' : Math.max(0, p.dailyLimit - (t.counts[p.name] || 0)),
    available: p.dailyLimit === 0 || (t.counts[p.name] || 0) < p.dailyLimit,
  }));
}

