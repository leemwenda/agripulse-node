export async function sendTelegram(message: string): Promise<void> {
  try {
    await fetch(`https://api.telegram.org/bot${TG_TOKEN}/sendMessage`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ chat_id: TG_CHAT_ID, text: message, parse_mode: 'HTML' }),
    });
    console.log('[Telegram] Sent');
  } catch (err) { console.error('[Telegram] Failed:', err); }
}

// ─── HTML Template ────────────────────────────────────────────────────────────
function base(title: string, bodyContent: string): string {
  const year = new Date().getFullYear();
  return `<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>${title}</title>
</head>
<body style="margin:0;padding:0;background-color:#f4f6f8;font-family:Arial,sans-serif;">
<table width="100%" cellpadding="0" cellspacing="0" style="background-color:#f4f6f8;padding:30px 0;">
<tr><td align="center">
<table width="600" cellpadding="0" cellspacing="0" style="background:#ffffff;border-radius:12px;overflow:hidden;max-width:600px;width:100%;">
  <tr>
    <td style="background:#2E7D32;padding:36px 40px;text-align:center;">
      <img src="${LOGO}" width="60" height="60" alt="${SITE}" style="border-radius:12px;display:inline-block;margin-bottom:14px;">
      <h1 style="color:#ffffff;margin:0;font-size:26px;font-weight:700;letter-spacing:-0.3px;">${SITE}</h1>
      <p style="color:#e8f5e9;margin:8px 0 0;font-size:14px;">Empowering Agriculture Through Technology</p>
    </td>
  </tr>
  <tr>
    <td style="padding:40px;">
      <h2 style="color:#1a1a1a;margin:0 0 20px;font-size:22px;font-weight:700;">${title}</h2>
      ${bodyContent}
      <p style="color:#555555;margin:28px 0 0;line-height:1.8;">Best regards,<br><strong style="color:#2E7D32;">The ${SITE} Team</strong></p>
    </td>
  </tr>
  <tr>
    <td style="background:#f1f5f9;padding:28px 40px;text-align:center;border-top:1px solid #e5e7eb;">
      <p style="margin:0;color:#2E7D32;font-size:15px;font-weight:700;">${SITE} 🌱</p>
      <p style="margin:6px 0;color:#666666;font-size:13px;">Empowering Agriculture Through Technology</p>
      <p style="margin:6px 0;color:#666666;font-size:13px;">
        <a href="mailto:notifications@agripulse.me" style="color:#2E7D32;text-decoration:none;">notifications@agripulse.me</a>
        &nbsp;|&nbsp;
        <a href="${URL}" style="color:#2E7D32;text-decoration:none;">agripulse.me</a>
      </p>
      <p style="margin:14px 0 0;color:#999999;font-size:12px;">&copy; ${year} ${SITE}. All Rights Reserved.</p>
    </td>
  </tr>
</table>
</td></tr>
</table>
</body>
</html>`;
}

function p(text: string): string {
  return `<p style="color:#555555;line-height:1.8;margin:0 0 16px;">${text}</p>`;
}
function btn(text: string, url: string): string {
  return `<table cellpadding="0" cellspacing="0" style="margin:24px 0;"><tr><td align="center" bgcolor="#2E7D32" style="border-radius:6px;"><a href="${url}" style="display:inline-block;padding:14px 28px;color:#ffffff;text-decoration:none;font-weight:bold;font-size:15px;">${text}</a></td></tr></table>`;
}
function infoCard(title: string, rows: [string, string][]): string {
  const cells = rows.map(([l, v]) => `<tr><td style="padding:12px 18px;color:#666666;font-size:14px;border-bottom:1px solid #f0f0f0;width:160px;white-space:nowrap;">${l}</td><td style="padding:12px 18px;color:#1a1a1a;font-size:14px;font-weight:600;border-bottom:1px solid #f0f0f0;">${v}</td></tr>`).join('');
  return `<table width="100%" cellpadding="0" cellspacing="0" style="border:1px solid #e5e7eb;border-radius:8px;overflow:hidden;margin:16px 0;"><tr><td colspan="2" style="padding:12px 18px;background:#f9fafb;border-bottom:1px solid #e5e7eb;font-size:14px;font-weight:700;color:#1a1a1a;">${title}</td></tr>${cells}</table>`;
}
function alertBox(message: string, type: 'danger'|'warning'|'success'|'info'): string {
  const S: Record<string,{bg:string;border:string;color:string;label:string}> = {
    danger:  {bg:'#fef2f2',border:'#dc2626',color:'#991b1b',label:'Action Required'},
    warning: {bg:'#fffbeb',border:'#f59e0b',color:'#92400e',label:'Notice'},
    success: {bg:'#f0fdf4',border:'#2E7D32',color:'#14532d',label:'Confirmed'},
    info:    {bg:'#eff6ff',border:'#2563eb',color:'#1e3a8a',label:'Information'},
  };
  const s = S[type];
  return `<table width="100%" cellpadding="0" cellspacing="0" style="margin:16px 0;"><tr><td style="background:${s.bg};border-left:4px solid ${s.border};border-radius:0 8px 8px 0;padding:14px 18px;"><div style="font-size:11px;font-weight:700;color:${s.border};letter-spacing:1px;text-transform:uppercase;margin-bottom:6px;">${s.label}</div><div style="font-size:14px;color:${s.color};line-height:1.6;">${message}</div></td></tr></table>`;
}
function statsRow(items: {label:string;value:string}[]): string {
  const cols = items.map(i => `<td style="text-align:center;padding:18px 10px;background:#f9fafb;border:1px solid #e5e7eb;border-radius:8px;"><div style="font-size:26px;font-weight:800;color:#1a1a1a;">${i.value}</div><div style="font-size:11px;color:#666666;margin-top:4px;text-transform:uppercase;letter-spacing:0.5px;">${i.label}</div></td>`).join('<td style="width:8px;"></td>');
  return `<table width="100%" cellpadding="0" cellspacing="0" style="margin:16px 0;"><tr>${cols}</tr></table>`;
}
function ul(items: string[]): string {
  return `<ul style="margin:0 0 16px;padding-left:20px;">${items.map(i=>`<li style="color:#555555;line-height:1.8;">${i}</li>`).join('')}</ul>`;
}
function sectionTitle(text: string): string {
  return `<div style="font-size:13px;font-weight:700;color:#1a1a1a;text-transform:uppercase;letter-spacing:1px;margin:28px 0 10px;padding-bottom:8px;border-bottom:2px solid #2E7D32;">${text}</div>`;
}

