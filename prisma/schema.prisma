  @@index([threadId])
  @@map("vet_messages")
}

enum VetAppointmentStatus {
  confirmed
  completed
  cancelled
}

enum EmergencyAlertStatus {
  open
  resolved
}

model VetProfile {
  id                 Int                    @id @default(autoincrement())
  userId             Int                    @unique @map("user_id")
  licenseNumber      String                 @map("license_number")
  specialization     String?
  clinicName         String?                @map("clinic_name")
  bio                String?                @db.Text
  yearsExperience    Int?                   @map("years_experience")
  consultationFee    Decimal?               @db.Decimal(10, 2) @map("consultation_fee")
  verificationStatus VetVerificationStatus  @default(pending) @map("verification_status")
  rating             Decimal?               @db.Decimal(3, 2)
  totalReviews       Int                    @default(0) @map("total_reviews")
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")

  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  slots        VetAvailabilitySlot[]
  appointments VetAppointment[]      @relation("VetAppointments")
  alerts       VetEmergencyAlert[]   @relation("VetEmergencyAlerts")
  reviews      VetReview[]           @relation("VetReviews")
  threads      VetThread[]           @relation("VetThreads")
  treatments   Treatment[]           @relation("VetTreatments")
  vaccinations Vaccination[]         @relation("VetVaccinations")
  prescriptions Prescription[]       @relation("VetPrescriptions")
  certificates Certificate[]         @relation("VetCertificates")
  labTests     LabTest[]             @relation("VetLabTests")

  @@index([verificationStatus])
  @@map("vet_profiles")
}

model VetAvailabilitySlot {
  id        Int      @id @default(autoincrement())
  vetId     Int      @map("vet_id")
  date      DateTime @db.Date
  startTime String   @map("start_time")
  endTime   String   @map("end_time")
  isBooked  Boolean  @default(false) @map("is_booked")
  createdAt DateTime @default(now()) @map("created_at")

  vet         VetProfile      @relation(fields: [vetId], references: [id], onDelete: Cascade)
  appointment VetAppointment?

  @@index([vetId, date])
  @@map("vet_availability_slots")
}

model VetAppointment {
  id          Int                  @id @default(autoincrement())
  vetId       Int                  @map("vet_id")
  farmerId    Int                  @map("farmer_id")
  slotId      Int                  @unique @map("slot_id")
  animalId    Int?                 @map("animal_id")
  serviceType String               @map("service_type")
  notes       String?              @db.Text
  status      VetAppointmentStatus @default(confirmed)
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  vet    VetProfile          @relation("VetAppointments", fields: [vetId], references: [id], onDelete: Cascade)
  farmer User                @relation("FarmerAppointments", fields: [farmerId], references: [id], onDelete: Cascade)
  slot   VetAvailabilitySlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  review VetReview?
  treatments    Treatment[]
  vaccinations  Vaccination[]
  prescriptions Prescription[]
  certificates  Certificate[]
  labTests      LabTest[]

  @@index([vetId])
  @@index([farmerId])
  @@map("vet_appointments")
}

model VetEmergencyAlert {
  id        Int                   @id @default(autoincrement())
  vetId     Int                   @map("vet_id")
  farmerId  Int                   @map("farmer_id")
  animalId  Int?                  @map("animal_id")
  message   String                @db.Text
  status    EmergencyAlertStatus  @default(open)
  createdAt DateTime              @default(now()) @map("created_at")

  vet    VetProfile @relation("VetEmergencyAlerts", fields: [vetId], references: [id], onDelete: Cascade)
  farmer User       @relation("FarmerEmergencyAlerts", fields: [farmerId], references: [id], onDelete: Cascade)

  @@index([vetId])
  @@index([farmerId])
  @@map("vet_emergency_alerts")
}


enum CertificateType {
  health
  movement
  export
  vaccination
}

model Treatment {
