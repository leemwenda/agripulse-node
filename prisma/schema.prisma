  farmer      User            @relation("TreatmentsFarmer", fields: [farmerId], references: [id], onDelete: Cascade)
  appointment VetAppointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([animalId])
  @@index([vetId])
