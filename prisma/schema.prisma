generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

enum Role {
  superadmin
  admin
  worker
  buyer
  vet
}

enum AnimalStatus {
  active
  sold
  deceased
}

enum AnimalCategory {
  calf
  heifer
  cow
  bull_calf
  young_bull
  bull

  @@map("animal_category")
}

enum AnimalGender {
  male
  female
}

enum BreedingStatus {
  pending
  pregnant
  gave_birth
  failed
}

enum TransactionType {
  income
  expense
}

enum WorkerStatus {
  active
  inactive
}

enum IssueCategory {
  bug
  feature_request
  performance
  other
}

enum IssuePriority {
  low
  medium
  high
  critical
}

enum IssueStatus {
  open
  in_review
  resolved
  closed
}

enum AnnouncementType {
  info
  success
  warning
  update
}

enum RegistrationStatus {
  pending
  approved
  rejected
}

enum FlagType {
  toggle
  text
  number
  select
}

model User {
  id                 Int                @id @default(autoincrement())
  name               String
  email              String             @unique
  password           String
  role               Role               @default(worker)
  farmId             Int?               @map("farm_id")
  farmName           String?            @map("farm_name")
  county             String?            @map("county")
  phone              String?            @map("phone")
  isActive           Boolean            @default(true) @map("is_active")
  registrationStatus RegistrationStatus @default(approved) @map("registration_status")
  googleId           String?            @unique @map("google_id")
  lastLogin          DateTime?          @map("last_login")
  createdAt          DateTime           @default(now()) @map("created_at")

  farm                  User?                  @relation("FarmWorkers", fields: [farmId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  workers               User[]                 @relation("FarmWorkers")
  animals               Animal[]
  milkProduction        MilkProduction[]
  healthRecords         HealthRecord[]
  breeding              Breeding[]
  financialTransactions FinancialTransaction[]
  activityLogs          ActivityLog[]
  systemIssues          SystemIssue[]          @relation("ReportedIssues")
  resolvedIssues        SystemIssue[]          @relation("ResolvedIssues")
  announcements         SystemAnnouncement[]
  featureFlags          FeatureFlag[]
  rememberTokens        RememberToken[]
  emailVerifications    EmailVerification[]
  aiChatSessions        AiChatSession[]
  loginAttempts         LoginAttempt[]
  transfersFrom         OwnershipTransfer[] @relation("TransfersFrom")
  transfersTo           OwnershipTransfer[] @relation("TransfersTo")
  transfersInitiated    OwnershipTransfer[] @relation("TransfersInitiated")
  marketListings        MarketListing[]   @relation("MarketSeller")
  marketOffers          MarketOffer[]     @relation("OffersBuyer")
  marketThreads         MarketThread[]    @relation("ThreadsBuyer")
  marketMessages        MarketMessage[]   @relation("MessagesSenderV2")
  marketFavorites       MarketFavorite[]  @relation("UserFavorites")
  cartItems              CartItem[]        @relation("UserCartItems")

  reviewsGiven        MarketReview[]        @relation("ReviewsGiven")
  reviewsReceived     MarketReview[]        @relation("ReviewsReceived")
  marketSavedSearches MarketSavedSearch[]
  marketWatchlist     MarketWatchlist[]
  marketReportsFiled  MarketReport[]        @relation("ReportsFiled")
  marketReportsAgainst MarketReport[]       @relation("ReportsAgainst")
  marketNotifications MarketNotification[]

  vetReviewsGiven   VetReview[]  @relation("VetReviewsGiven")
  farmerVetThreads  VetThread[]  @relation("FarmerVetThreads")
  vetMessagesSent   VetMessage[] @relation("VetMessagesSender")
  treatmentsAsFarmer    Treatment[]    @relation("TreatmentsFarmer")
  vaccinationsAsFarmer  Vaccination[]  @relation("VaccinationsFarmer")
  prescriptionsAsFarmer Prescription[] @relation("PrescriptionsFarmer")
  certificatesAsFarmer  Certificate[]  @relation("CertificatesFarmer")
  labTestsAsFarmer      LabTest[]      @relation("LabTestsFarmer")

  vetProfile              VetProfile?
  vetAppointmentsAsFarmer VetAppointment[]    @relation("FarmerAppointments")
  vetEmergencyAlertsSent  VetEmergencyAlert[] @relation("FarmerEmergencyAlerts")
  @@map("users")
}

model RememberToken {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("remember_tokens")
}

model LoginAttempt {
  id          Int      @id @default(autoincrement())
  email       String
  ipAddress   String?  @map("ip_address")
  userId      Int?     @map("user_id")
  attemptedAt DateTime @default(now()) @map("attempted_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@map("login_attempts")
}

model Animal {
  id          Int          @id @default(autoincrement())
  farmId      Int          @map("farm_id")
  name        String
  tagNumber   String       @unique @map("tag_number")
  breed       String
  gender      AnimalGender
  category    AnimalCategory? @map("category")
  dateOfBirth DateTime     @map("date_of_birth") @db.Date
  color       String?
  notes       String?      @db.Text
  agripulseId String?      @unique @map("agripulse_id")
  status      AnimalStatus @default(active)
  createdAt   DateTime     @default(now()) @map("created_at")

  farm           User             @relation(fields: [farmId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  milkProduction MilkProduction[]
  healthRecords  HealthRecord[]
  breeding          Breeding[]
  weights           AnimalWeight[]
  photos            AnimalPhoto[]
  ownershipTransfers OwnershipTransfer[]
  listings           MarketListing[] @relation("MarketAnimal")
  treatments         Treatment[]
  vaccinations       Vaccination[]
  prescriptions      Prescription[]
  certificates       Certificate[]
  labTests           LabTest[]

  @@map("animals")
}

model MilkProduction {
  id             Int      @id @default(autoincrement())
  animalId       Int      @map("animal_id")
  farmId         Int      @map("farm_id")
  productionDate DateTime @map("production_date") @db.Date
  session        MilkSession @default(morning)
  quantityLiters Decimal  @map("quantity_liters") @db.Decimal(6, 2)
  notes          String?  @db.Text
  recordedBy     Int?      @map("recorded_by")
  createdAt      DateTime @default(now()) @map("created_at")

  animal     Animal @relation(fields: [animalId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  recordedByUser User?   @relation(fields: [recordedBy], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([animalId, productionDate, session])
  @@map("milk_production")
}

model HealthRecord {
  id          Int      @id @default(autoincrement())
  animalId    Int      @map("animal_id")
  farmId      Int      @map("farm_id")
  recordDate  DateTime @map("record_date") @db.Date
  condition   String
  treatment   String?  @db.Text
  doctorName  String?  @map("doctor_name")
  vaccination String?
  notes       String?  @db.Text
  recordedBy  Int?      @map("recorded_by")
  createdAt   DateTime @default(now()) @map("created_at")

  animal         Animal @relation(fields: [animalId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  recordedByUser User?   @relation(fields: [recordedBy], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("health_records")
}

model Breeding {
  id                Int            @id @default(autoincrement())
  animalId          Int            @map("animal_id")
  farmId            Int            @map("farm_id")
  serviceDate       DateTime       @map("service_date") @db.Date
  bullName          String?        @map("bull_name")
  expectedBirthDate DateTime?      @map("expected_birth_date") @db.Date
  actualBirthDate   DateTime?      @map("actual_birth_date") @db.Date
  pregnancyStatus   BreedingStatus @default(pending) @map("pregnancy_status")
  notes             String?        @db.Text
  recordedBy        Int?            @map("recorded_by")
  createdAt         DateTime       @default(now()) @map("created_at")

  animal         Animal @relation(fields: [animalId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  recordedByUser User?   @relation(fields: [recordedBy], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("breeding")
}

model FinancialTransaction {
  id              Int             @id @default(autoincrement())
  farmId          Int             @map("farm_id")
  type            TransactionType
  category        String
  amount          Decimal         @db.Decimal(10, 2)
  description     String?         @db.Text
  transactionDate DateTime        @map("transaction_date") @db.Date
  recordedBy      Int?             @map("recorded_by")
  createdAt       DateTime        @default(now()) @map("created_at")

  recordedByUser User? @relation(fields: [recordedBy], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("financial_transactions")
}

model FeatureFlag {
  id          Int      @id @default(autoincrement())
  flagKey     String   @unique @map("flag_key")
  label       String
  description String?  @db.Text
  type        FlagType @default(toggle)
  value       String?  @db.VarChar(255)
  options     String?  @db.Text
  category    String?  @default("General")
  updatedBy   Int?     @map("updated_by")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  updatedByUser User? @relation(fields: [updatedBy], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@map("feature_flags")
}

model SystemIssue {
  id          Int           @id @default(autoincrement())
  reportedBy  Int           @map("reported_by")
  title       String
  description String        @db.Text
  category    IssueCategory @default(bug)
  priority    IssuePriority @default(medium)
  status      IssueStatus   @default(open)
  adminNote   String?       @map("admin_note") @db.Text
  resolvedBy  Int?          @map("resolved_by")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  reporter User  @relation("ReportedIssues", fields: [reportedBy], references: [id], onDelete: Cascade, onUpdate: NoAction)
  resolver User? @relation("ResolvedIssues", fields: [resolvedBy], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@map("system_issues")
}

model SystemAnnouncement {
  id        Int              @id @default(autoincrement())
  title     String
  body      String           @db.Text
  type      AnnouncementType @default(info)
  isActive  Boolean          @default(true) @map("is_active")
  createdBy Int              @map("created_by")
  createdAt DateTime         @default(now()) @map("created_at")

  createdByUser User @relation(fields: [createdBy], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("system_announcements")
}

model ActivityLog {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id")
  action    String
  entity    String?
  entityId  Int?     @map("entity_id")
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@map("activity_log")
}

model AiChatSession {
  id        Int      @id @default(autoincrement())
  farmId    Int      @map("farm_id")
  userId    Int      @map("user_id")
  title     String   @default("New Conversation")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  conversations AiConversation[]

  @@map("ai_chat_sessions")
}

model AiConversation {
  id        Int      @id @default(autoincrement())
  sessionId Int      @map("session_id")
  role      String
  message   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  session AiChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("ai_conversations")
}

model EmailVerification {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("email_verifications")
}



// ── PHASE 1: Digital Animal Passport ─────────────────

enum TransferMethod {
  in_app
  qr_code
  dual_confirmation
}

enum TransferStatus {
  pending
  completed
  cancelled
}

enum OfferStatus {
  pending
  accepted
  rejected
  withdrawn
  countered
}
// ═══════════════════════════════════════════════════════════════
// MARKETPLACE V2
// ═══════════════════════════════════════════════════════════════

enum MarketListingStatus {
  draft
  active
  reserved
  sold
  expired
  cancelled
}


enum AgreementStatus {
  draft
  buyer_signed
  seller_signed
  complete
  cancelled
}

enum MessageType {
  text
  offer
  system
}

model MarketListing {
  id              Int                   @id @default(autoincrement())
  animalId        Int                   @unique @map("animal_id")
  sellerId        Int                   @map("seller_id")
  title           String
  description     String?               @db.Text
  askingPrice     Decimal               @map("asking_price") @db.Decimal(12, 2)
  negotiable      Boolean               @default(true)
  county          String
  town            String?
  status          MarketListingStatus   @default(active)
  featured        Boolean               @default(false)
  viewCount       Int                   @default(0) @map("view_count")
  expiresAt       DateTime?             @map("expires_at")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  animal    Animal              @relation("MarketAnimal", fields: [animalId], references: [id], onDelete: Cascade)
  seller    User                @relation("MarketSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  photos    MarketPhoto[]
  offers    MarketOffer[]
  threads   MarketThread[]
  favorites MarketFavorite[]
  agreement MarketAgreement?
  views     MarketView[]
  cartItems CartItem[]    @relation("ListingCartItems")
  reviews   MarketReview[]
  watchedBy MarketWatchlist[]
  reports   MarketReport[]

  @@index([sellerId])
  @@index([status])
  @@index([county])
  @@index([createdAt])
  @@map("market_listings")
}

model MarketPhoto {
  id        Int          @id @default(autoincrement())
  listingId Int          @map("listing_id")
  url       String
  isPrimary Boolean      @default(false) @map("is_primary")
  order     Int          @default(0)
  createdAt DateTime     @default(now()) @map("created_at")

  listing MarketListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@map("market_photos")
}

model MarketOffer {
  id          Int         @id @default(autoincrement())
  listingId   Int         @map("listing_id")
  buyerId     Int         @map("buyer_id")
  amount      Decimal     @db.Decimal(12, 2)
  note        String?     @db.Text
  status      OfferStatus @default(pending)
  parentId    Int?        @map("parent_id")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  listing   MarketListing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyer     User           @relation("OffersBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  parent    MarketOffer?   @relation("OfferCounters", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  counters  MarketOffer[]  @relation("OfferCounters")

  @@index([listingId])
  @@index([buyerId])
  @@map("market_offers")
}

model MarketThread {
  id                Int       @id @default(autoincrement())
  listingId         Int       @map("listing_id")
  buyerId           Int       @map("buyer_id")
  buyerLastReadAt   DateTime? @map("buyer_last_read_at")
  sellerLastReadAt  DateTime? @map("seller_last_read_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  listing  MarketListing    @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyer    User             @relation("ThreadsBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  messages MarketMessage[]

  @@unique([listingId, buyerId])
  @@index([buyerId])
  @@map("market_threads")
}

model MarketMessage {
  id        Int         @id @default(autoincrement())
  threadId  Int         @map("thread_id")
  senderId  Int         @map("sender_id")
  body      String      @db.Text
  type      MessageType @default(text)
  createdAt DateTime    @default(now()) @map("created_at")

  thread MarketThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender User         @relation("MessagesSenderV2", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@map("market_messages")
}

model MarketFavorite {
  id        Int      @id @default(autoincrement())
  listingId Int      @map("listing_id")
  userId    Int      @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  listing MarketListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user    User          @relation("UserFavorites", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([listingId, userId])
  @@index([userId])
  @@map("market_favorites")
}

model MarketView {
  id        Int      @id @default(autoincrement())
  listingId Int      @map("listing_id")
  ip        String?
  userId    Int?     @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  listing MarketListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@map("market_views")
}

model MarketAgreement {
  id              Int             @id @default(autoincrement())
  listingId       Int             @unique @map("listing_id")
  offerId         Int             @unique @map("offer_id")
  agreedPrice     Decimal         @map("agreed_price") @db.Decimal(12, 2)
  status          AgreementStatus @default(draft)
  buyerSignature  String?         @db.Text @map("buyer_signature")
  buyerSignedAt   DateTime?       @map("buyer_signed_at")
  sellerSignature String?         @db.Text @map("seller_signature")
  sellerSignedAt  DateTime?       @map("seller_signed_at")
  pdfUrl          String?         @map("pdf_url")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  listing MarketListing @relation(fields: [listingId], references: [id])

  @@map("market_agreements")
}


// ── PHASE 1: Digital Passport models ─────────────────────────────────────────

model AnimalWeight {
  id         Int      @id @default(autoincrement())
  animalId   Int      @map("animal_id")
  weightKg   Decimal  @map("weight_kg") @db.Decimal(8, 2)
  recordedAt DateTime @default(now()) @map("recorded_at")
  notes      String?  @db.Text

  animal Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)

  @@index([animalId])
  @@map("animal_weights")
}

model AnimalPhoto {
  id         Int      @id @default(autoincrement())
  animalId   Int      @map("animal_id")
  url        String
  isPrimary  Boolean  @default(false) @map("is_primary")
  uploadedAt DateTime @default(now()) @map("uploaded_at")

  animal Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)

  @@index([animalId])
  @@map("animal_photos")
}

model OwnershipTransfer {
  id           Int            @id @default(autoincrement())
  animalId     Int            @map("animal_id")
  fromUserId   Int            @map("from_user_id")
  toUserId     Int?           @map("to_user_id")
  initiatedBy  Int            @map("initiated_by")
  method       TransferMethod @default(in_app)
  status       TransferStatus @default(pending)
  price        Decimal?       @db.Decimal(12, 2)
  notes        String?        @db.Text
  transferCode String?        @unique @map("transfer_code")
  transferDate DateTime?      @map("transfer_date")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  animal    Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)
  fromUser  User   @relation("TransfersFrom", fields: [fromUserId], references: [id])
  toUser    User?  @relation("TransfersTo", fields: [toUserId], references: [id])
  initiator User   @relation("TransfersInitiated", fields: [initiatedBy], references: [id])

  @@index([animalId])
  @@index([fromUserId])
  @@index([toUserId])
  @@map("ownership_transfers")
}

model CartItem {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  listingId Int      @map("listing_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User          @relation("UserCartItems", fields: [userId], references: [id], onDelete: Cascade)
  listing MarketListing @relation("ListingCartItems", fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([userId])
  @@map("cart_items")
}

// ── PHASE: Marketplace Extensions ────────────────────────

enum ReportStatus {
  pending
  reviewing
  resolved
  dismissed
}

model MarketReview {
  id          Int      @id @default(autoincrement())
  listingId   Int      @map("listing_id")
  reviewerId  Int      @map("reviewer_id")
  revieweeId  Int      @map("reviewee_id")
  rating      Int
  comment     String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  listing  MarketListing @relation(fields: [listingId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  reviewer User          @relation("ReviewsGiven", fields: [reviewerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  reviewee User          @relation("ReviewsReceived", fields: [revieweeId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([revieweeId])
  @@map("market_reviews")
}

model MarketSavedSearch {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  name      String
  filters   String   @db.Text
  alertsOn  Boolean  @default(true) @map("alerts_on")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
  @@map("market_saved_searches")
}

model MarketWatchlist {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  listingId Int      @map("listing_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  listing MarketListing @relation(fields: [listingId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, listingId])
  @@map("market_watchlist")
}

model MarketReport {
  id          Int          @id @default(autoincrement())
  reporterId  Int          @map("reporter_id")
  listingId   Int?         @map("listing_id")
  reportedUserId Int?      @map("reported_user_id")
  reason      String
  details     String?      @db.Text
  status      ReportStatus @default(pending)
  createdAt   DateTime     @default(now()) @map("created_at")
  resolvedAt  DateTime?    @map("resolved_at")

  reporter     User           @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  listing      MarketListing? @relation(fields: [listingId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  reportedUser User?          @relation("ReportsAgainst", fields: [reportedUserId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([status])
  @@map("market_reports")
}

model MarketNotification {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  type      String
  title     String
  body      String   @db.Text
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, read])
  @@map("market_notifications")
}


// ─── VETERINARY SYSTEM ──────────────────────────────────────────────────────
enum VetVerificationStatus {
  pending
  verified
  rejected
}

model VetReview {
  id            Int      @id @default(autoincrement())
  appointmentId Int      @unique @map("appointment_id")
  vetId         Int      @map("vet_id")
  farmerId      Int      @map("farmer_id")
  rating        Int
  comment       String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at")

  appointment VetAppointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  vet         VetProfile     @relation("VetReviews", fields: [vetId], references: [id], onDelete: Cascade)
  farmer      User           @relation("VetReviewsGiven", fields: [farmerId], references: [id], onDelete: Cascade)

  @@index([vetId])
  @@map("vet_reviews")
}

model VetThread {
  id             Int       @id @default(autoincrement())
  vetId          Int       @map("vet_id")
  farmerId       Int       @map("farmer_id")
  vetLastReadAt  DateTime? @map("vet_last_read_at")
  farmerLastReadAt DateTime? @map("farmer_last_read_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  vet      VetProfile   @relation("VetThreads", fields: [vetId], references: [id], onDelete: Cascade)
