  animalId       Int       @map("animal_id")
  vetId          Int       @map("vet_id")
  farmerId       Int       @map("farmer_id")
  appointmentId  Int?      @map("appointment_id")
  testType       String    @map("test_type")
  sampleDate     DateTime  @map("sample_date") @db.Date
