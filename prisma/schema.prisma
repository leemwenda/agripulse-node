  vet         VetProfile      @relation("VetPrescriptions", fields: [vetId], references: [id], onDelete: Cascade)
  farmer      User            @relation("PrescriptionsFarmer", fields: [farmerId], references: [id], onDelete: Cascade)
  appointment VetAppointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([animalId])
